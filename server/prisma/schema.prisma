generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String   @unique
  password  String
  role      Role     @default(CITIZEN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districtId      String?
  tehsilId        String?
  applications    Application[]        @relation("Applicant")
  workflowHistory ApplicationHistory[] @relation("UserWorkflowHistory")
  profile         CitizenProfile?

  district District? @relation(fields: [districtId], references: [id])
  tehsil   Tehsil?   @relation(fields: [tehsilId], references: [id])

  villageId String?
  village   Village? @relation(fields: [villageId], references: [id])

  assignedAsDA        Application[] @relation("AssignedDA")
  assignedAsPatwari   Application[] @relation("AssignedPatwari")
  assignedAsTehsildar Application[] @relation("AssignedTehsildar")

  clarificationsSent  ClarificationQuery[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  citizenComplaints   Complaint[] @relation("CitizenComplaints")
  officerComplaints   Complaint[] @relation("OfficerComplaints")
}

model District {
  id              String           @id @default(uuid())
  name            String           @unique
  lgdCode         Int              @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  citizenProfiles CitizenProfile[]
  tehsils         Tehsil[]
  users           User[]
}

model Tehsil {
  id              String           @id @default(uuid())
  name            String
  lgdCode         Int              @unique
  districtId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  citizenProfiles CitizenProfile[]
  district        District         @relation(fields: [districtId], references: [id])
  users           User[]
  villages        Village[]

  @@unique([districtId, name])
  @@index([districtId])
}

model Village {
  id              String           @id @default(uuid())
  name            String
  tehsilId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lgdCode         Int              @unique
  citizenProfiles CitizenProfile[]
  tehsil          Tehsil           @relation(fields: [tehsilId], references: [id])
  users           User[]

  @@index([tehsilId])
}

model Department {
  id                  String               @id @default(uuid())
  name                String               @unique
  code                String               @unique
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  certificateServices CertificateService[]
}

model CertificateService {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String   @unique
  description    String?
  processingDays Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  departmentId String

  applications      Application[]
  requiredDocuments RequiredDocument[]
  form              ServiceForm?
  department        Department         @relation(fields: [departmentId], references: [id])
}

model ServiceForm {
  id          String  @id @default(uuid())
  title       String
  description String?

  serviceId String             @unique
  service   CertificateService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  fields ServiceFormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model ServiceFormField {
  id String @id @default(uuid())

  label     String
  fieldKey  String
  fieldType FormFieldType

  placeholder  String?
  defaultValue String?

  isRequired   Boolean @default(true)
  displayOrder Int

  options Json?

  formId String
  form   ServiceForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, fieldKey])
  @@index([formId])
}

model RequiredDocument {
  id           String  @id @default(uuid())
  name         String
  isMandatory  Boolean @default(true)
  displayOrder Int     @default(1)

  serviceId String
  service   CertificateService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  uploadedDocuments ApplicationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, name])
  @@index([serviceId])
}

model CitizenProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  aadhaarNumber String?   @unique
  gender        Gender?
  dateOfBirth   DateTime?
  fatherName    String?
  motherName    String?
  address       String?
  pincode       String?
  districtId    String?
  tehsilId      String?
  villageId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  district      District? @relation(fields: [districtId], references: [id])
  tehsil        Tehsil?   @relation(fields: [tehsilId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  village       Village?  @relation(fields: [villageId], references: [id])
}

model Application {
  id                   String  @id @default(uuid())
  applicationNumber    String? @unique
  applicantId          String
  certificateServiceId String

  status       ApplicationStatus @default(DRAFT)
  isSubmitted  Boolean           @default(false)
  currentStage WorkflowStage?

  // Officer assignment snapshot
  assignedDAId        String?
  assignedPatwariId   String?
  assignedTehsildarId String?

  assignedDA        User? @relation("AssignedDA", fields: [assignedDAId], references: [id])
  assignedPatwari   User? @relation("AssignedPatwari", fields: [assignedPatwariId], references: [id])
  assignedTehsildar User? @relation("AssignedTehsildar", fields: [assignedTehsildarId], references: [id])

  stageStartedAt DateTime  @default(now())
  stageDeadline  DateTime?

  isEscalated Boolean   @default(false)
  escalatedAt DateTime?

  remarks  String?
  formData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificateNumber String? @unique
  certificateUrl    String?

  priorityScore            Int       @default(20)
  predictedCompletionDays  Float?
  escalationReason         String?
  certificateIssuedAt      DateTime?

  applicant          User               @relation("Applicant", fields: [applicantId], references: [id])
  certificateService CertificateService @relation(fields: [certificateServiceId], references: [id])

  documents      ApplicationDocument[]
  history        ApplicationHistory[]
  clarifications ClarificationQuery[]
  auditLogs      AuditLog[]
  complaints     Complaint[]
}

model ApplicationDocument {
  id String @id @default(uuid())

  applicationId      String
  requiredDocumentId String

  originalFileName String
  fileUrl          String
  fileSize         Int
  mimeType         String

  uploadedAt DateTime @default(now())

  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requiredDocument RequiredDocument @relation(fields: [requiredDocumentId], references: [id])

  @@unique([applicationId, requiredDocumentId])
  @@index([applicationId])
  @@index([requiredDocumentId])
}

model ApplicationHistory {
  id            String         @id @default(uuid())
  applicationId String
  officerId     String
  fromStage     WorkflowStage
  toStage       WorkflowStage
  action        WorkflowAction
  remarks       String?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  officer       User           @relation("UserWorkflowHistory", fields: [officerId], references: [id])
}

model ClarificationQuery {
  id            String    @id @default(uuid())
  applicationId String
  senderId      String
  senderRole    Role
  message       String
  status        String    @default("PENDING") // PENDING, RESOLVED
  replyMessage  String?
  replyFileUrl  String?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([applicationId])
}

model AuditLog {
  id            String    @id @default(uuid())
  applicationId String?
  userId        String?
  userName      String?
  userRole      String?
  action        String    // e.g. "VIEW_FILE", "FORWARDED_STAGE", "APPROVED_CERTIFICATE", "ESCALATED_SLA"
  stage         String?
  details       String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, URGENT, SUCCESS, WARNING
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  CITIZEN
  DA
  PATWARI
  TEHSILDAR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_PROGRESS
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
}

enum WorkflowStage {
  DA
  PATWARI
  DA_REVIEW
  TEHSILDAR
  COMPLETED
}

enum WorkflowAction {
  FORWARD
  APPROVE
  REJECT
  CORRECTION_REQUIRED
}

enum FormFieldType {
  TEXT
  NUMBER
  DATE
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
}

model Complaint {
  id              String          @id @default(uuid())
  applicationId   String
  citizenId       String
  officerId       String?         // The officer against whom the complaint is raised (who is currently assigned)
  message         String
  status          ComplaintStatus @default(OPEN)
  resolution      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  citizen         User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  officer         User?           @relation("OfficerComplaints", fields: [officerId], references: [id])

  @@index([applicationId])
  @@index([citizenId])
  @@index([officerId])
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}
